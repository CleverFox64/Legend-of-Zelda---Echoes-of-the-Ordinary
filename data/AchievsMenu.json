			},
			{
				"symbol": "Unlocking",
				"script": "locked.sort(function(a, b) {var pa = a.progress(); var pb = b.progress(); return pb - pa || a.tname.localeCompare(b.tname, 'en', { sensitivity: 'base' })});\nmain = locked.concat(unlocked, secrets);"
